# Base rules: ignore all files without extensions, keep directories and files with extensions
*
!*/
!*.*

# IDE / Editors
.vscode/
.idea/
.cursorignore
.kiro
.codex
.codebuddy
.claude*

# OS
.DS_Store

# Node.js / Frontend
node_modules/
.next/
next-env.d.ts
pnpm-lock.yaml

# Python
__pycache__/
.venv/

# Go
*.out
.gocache/
.gomodcache/

# Test & Coverage
coverage.out
coverage.html
cover.html
*test*.sh
*test*.exp
*test*.py

# Logs & Database
*.log
*.db

# Environment & Secrets
.env

# Temp / Scripts
claude3.7.sh
dpskv3.sh
dpskv4.sh
glm.sh

# Docs & PR
PR*.md
pr*.md
# CLAUDE.md

# Examples & Evaluation Results
examples/results/
examples/**/*.evalset_result.json
examples/knowledge/evaluation/dataset/*

# Exceptions: force include
!LICENSE
!.github/CODEOWNERS
!.github/scripts/run-go-tests.sh
!openclaw/examples/sandbox_service_execution/Dockerfile
!docs/mkdocs/zh/promptiter.md
!docs/mkdocs/en/promptiter.md
!docs/mkdocs/zh/blog/promptiter.md
!docs/mkdocs/en/blog/promptiter.md
!examples/evaluation/**/*.evalset_result.json
!examples/claudecode/.claude
!examples/evaluation/claudecode/.claude
